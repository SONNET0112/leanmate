# ===== 前端公开配置（会被打进构建产物，只能是 publishable / anon key）=====
# 在 Supabase Dashboard → Project Settings → API 里取；不填则网站以「仅本机」模式运行
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 绝对不要把 service_role key、数据库密码写进这里或任何 VITE_ 变量

# AI 饮食识别配置（只放服务端环境变量，不要写进前端代码或提交真实密钥）
# 兼容任何 OpenAI Chat Completions 接口；推荐放在 .env.local（已在 .gitignore 中）
#
# 默认（TokenRiver 聚合，模型别名 deepseek-flash = deepseek-v4.1-flash）：
AI_BASE_URL=https://api.tokenriver.cn/v1
AI_MODEL=deepseek-flash
AI_API_KEY=
# 本机已存在 TOKENRIVER_API_KEY 时会自动复用，无需再填 AI_API_KEY
#
# DeepSeek 官方直连（该账号下可用模型：deepseek-flash、deepseek-v4-pro）：
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=45000
